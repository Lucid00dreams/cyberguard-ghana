# --- Database (Supabase free tier) ---
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="15m"

# --- Server ---
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# --- Cloudflare R2 (S3-compatible object storage, free tier) ---
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="cyberguard-evidence"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# --- Rate limiting ---
INCIDENT_SUBMIT_RATE_LIMIT_WINDOW_MS=3600000
INCIDENT_SUBMIT_RATE_LIMIT_MAX=10

# --- SMTP Email Configuration ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="cyberguardgh@gmail.com"
SMTP_PASS="your-app-password-here"
FROM_EMAIL="CyberGuard Ghana <cyberguardgh@gmail.com>"
